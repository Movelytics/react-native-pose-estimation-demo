{
  "expo": {
    "name": "posetracker-sdk-testapp",
    "slug": "posetracker-demo-app",
    "owner": "posetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.posetracker.sdktestapp",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra alimente l'estimation de pose MoveNet on-device (test SDK)."
      }
    },
    "android": {
      "package": "com.posetracker.sdktestapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra alimente l'estimation de pose MoveNet on-device (test SDK)."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "20ebd76d-2138-4833-b376-ad4e1233187a"
      }
    }
  }
}
